	cd /home/fogli/CHARM && $(MAKE) $(MAKESILENT) -f application/ermia-alpha1/CMakeFiles/ermia_si.dir/build.make application/ermia-alpha1/CMakeFiles/ermia_si.dir/tuple.cc.s
.PHONY : tuple.cc.s

